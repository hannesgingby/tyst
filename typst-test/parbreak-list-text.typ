#set page(
  paper: "a4",
  margin: (left: 2.5cm, right: 2.5cm, top: 2.5cm, bottom: 2.5cm),
  fill: rgb("#FFFFFF"),
)

#set text(
  font: "Libertinus Serif",
  size: 11pt,
  weight: "regular",
  fill: rgb("#000000"),
)

#set par(
  leading: 0.65em,
  spacing: 1.7em,
  justify: false,
)

